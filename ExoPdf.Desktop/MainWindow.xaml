<Window x:Class="ExoPdf.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ExoPdf" Height="640" Width="960" MinHeight="480" MinWidth="720">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <!-- Rows in reading order (title, operations, footer) so keyboard order matches what is seen.
                 Tab treats the sidebar as one stop; the arrow keys move between entries. -->
            <Grid Margin="8,16" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="ExoPdf" FontSize="18" FontWeight="SemiBold"
                           Margin="12,0,12,16"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                <ItemsControl Grid.Row="1" Style="{StaticResource NavList}"
                              ItemsSource="{Binding Pages}"
                              AutomationProperties.Name="Operations navigation" />

                <ItemsControl Grid.Row="2" Style="{StaticResource NavList}"
                              ItemsSource="{Binding FooterPages}"
                              AutomationProperties.Name="Settings navigation" />
            </Grid>
        </Border>

        <!-- Page content. The View is chosen by the DataTemplate registered for the ViewModel type. -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        IsTabStop="False" />
    </Grid>
</Window>
