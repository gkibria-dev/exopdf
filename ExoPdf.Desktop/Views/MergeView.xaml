<UserControl x:Class="ExoPdf.Desktop.Views.MergeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ExoPdf.Desktop.Behaviors">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Merge PDFs" Style="{StaticResource PageTitle}" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource PageSubtitle}"
                       Text="Combine every PDF in a folder into one file. Files are merged in file-name order." />
        </StackPanel>

        <!-- Folder picker; also a drop target for folders -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16"
                behaviors:FolderDropBehavior.Command="{Binding SelectFolderCommand}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Source folder" Style="{StaticResource SectionLabel}" />
                    <TextBlock Margin="0,4,0,0" FontSize="14" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding SourceFolder}"
                               AutomationProperties.Name="Selected source folder">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding SourceFolder}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFolder}" Value="False">
                                        <Setter Property="Text" Value="Choose a folder, or drop one here" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <Button Grid.Column="1" Content="_Browse…" MinWidth="96"
                        Command="{Binding BrowseCommand}"
                        AutomationProperties.Name="Browse for a source folder" />
            </Grid>
        </Border>

        <!-- Files that will be merged -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="16,12">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding FileCountText}" Style="{StaticResource SectionLabel}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="PDF files, in merge order" Style="{StaticResource SectionLabel}"
                               VerticalAlignment="Center" />
                </DockPanel>

                <!-- Shown while the folder is being read; a slow folder never blocks the window. -->
                <ProgressBar Grid.Row="0" IsIndeterminate="True" Height="2" VerticalAlignment="Bottom"
                             AutomationProperties.Name="Reading the folder"
                             Visibility="{Binding IsLoadingFiles, Converter={StaticResource BoolToVisibility}}" />

                <ListBox Grid.Row="1" ItemsSource="{Binding Files}" BorderThickness="0" Background="Transparent"
                         AutomationProperties.Name="PDF files to merge">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,2">
                                <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           VerticalAlignment="Center" Margin="0,0,12,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty state: hidden as soon as there are files. -->
                <TextBlock Grid.Row="1" Text="{Binding EmptyStateText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PageSubtitle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasFiles}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Outcome -->
        <StackPanel Grid.Row="3">
            <Border Style="{StaticResource SuccessPanel}" Margin="0,0,0,16"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding Result.Summary}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Margin="0,4,0,12" TextWrapping="Wrap" FontSize="14"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="{Binding Result.OutputFilePath}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="_Open file" Command="{Binding Result.OpenCommand}" Margin="0,0,8,0" />
                        <Button Content="Show in _folder" Command="{Binding Result.ShowInFolderCommand}" />
                    </StackPanel>
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                               Text="{Binding Result.LaunchError}"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               Visibility="{Binding Result.HasLaunchError, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                    Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding NoticeMessage}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </Border>

            <Border Style="{StaticResource ErrorPanel}" Margin="0,0,0,16"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.LiveSetting="Assertive">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </Border>
        </StackPanel>

        <!-- Action -->
        <DockPanel Grid.Row="4">
            <Button DockPanel.Dock="Right" MinWidth="120" Style="{StaticResource AccentButtonStyle}"
                    Command="{Binding MergeCommand}" IsDefault="True"
                    AutomationProperties.Name="Merge PDF files">
                <AccessText>
                    <AccessText.Style>
                        <Style TargetType="AccessText">
                            <Setter Property="Text" Value="_Merge" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Text" Value="Merging…" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </AccessText.Style>
                </AccessText>
            </Button>
            <Button DockPanel.Dock="Right" Content="_Cancel" MinWidth="96" Margin="0,0,8,0" IsCancel="True"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="Cancel the merge"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"
                           TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                <!-- Determinate per file, then indeterminate while the merged file is written. -->
                <ProgressBar Minimum="0" Maximum="{Binding TotalFiles}" Value="{Binding FilesCompleted}" Height="4"
                             IsIndeterminate="{Binding IsSaving}"
                             AutomationProperties.Name="Merge progress" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
